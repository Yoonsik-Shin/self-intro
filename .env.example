# docker compose 로컬 실행 시 필요한 값. 이 파일을 복사해서 .env로 만들고 값을 채우세요.
#   cp .env.example .env
#
# 비밀번호는 평문으로 넣으면 앱이 기동할 때 자동으로 BCrypt 해시화합니다. 직접 해시를
# 만들 필요 없음. (이미 해시를 갖고 있다면 ADMIN_PASSWORD_HASH를 대신 써도 됩니다 —
# 단, 그 값은 $ 문자가 많아서 docker compose가 .env를 읽을 때 오작동하지 않도록
# $ 하나마다 $$ 로 이스케이프해야 합니다. 웬만하면 ADMIN_PASSWORD를 쓰는 걸 권장.)

ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 플랫폼 운영자 MFA 비밀키 암호화 및 복구 코드 로그인 후 재등록 세션 유효시간.
# 운영 키는 반드시 Secret Manager/SealedSecret으로 주입하고 저장소에 커밋하지 않습니다.
# MFA_ENCRYPTION_KEY=<Base64로 인코딩한 랜덤 32바이트 키>
MFA_RECOVERY_SESSION_VALID_FOR=15m

# 로컬 Grafana(모니터링) 관리자 계정. 비워두면 admin/admin으로 뜹니다.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# NVIDIA NIM 기반 AI 초안 생성. https://build.nvidia.com 에서 발급한 키를 입력하세요.
# 핵심 역량 / 공부 정리 / 이력·경력 초안 생성은 키만 넣으면 바로 켜집니다(별도 on/off 없음).
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_MAX_OUTPUT_TOKENS=8192
VECTOR_SYNC_DLQ_MESSAGE_TTL_MS=604800000
PDF_DRAFT_AI_TIMEOUT=240s
# 채용공고가 텍스트 대신 배너 이미지로만 정보를 제공할 때 보조로 호출하는 비전 모델. 필수값이며
# 코드에는 기본값을 두지 않았으니 반드시 채워야 합니다.
NVIDIA_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl

# 채용공고 URL AI 분석 / 수집 공고 AI 매칭 점수도 위 NVIDIA_API_KEY만 있으면 바로 켜집니다(별도 on/off 없음).

# 채용 공고 관리 - 사람인 Open API 기반 유사 공고 수집
# https://oapi.saramin.co.kr/join 에서 신청 후 승인받아 발급받은 access-key를 입력하세요.
# 사용 여부/검색 키워드·개수·정렬/지역·직무·업종 코드/자동 스케줄 사용여부·주기/매칭 임계치는
# 여기 넣는 게 아니라 어드민 화면(지원 공고 관리 > 수집 설정)에서 재배포 없이 바로 바꿉니다.
SARAMIN_ACCESS_KEY=

# 이미지 업로드용 오브젝트 스토리지 (S3 호환)
# 로컬은 docker-compose가 MinIO 컨테이너와 기본값을 이미 다 채워주므로 보통 .env에
# 아래 값을 따로 적을 필요가 없습니다. 운영(Oracle Object Storage)에 배포할 때만
# K8s 쪽 설정(deploy/k8s/overlays/prod)에서 실제 값으로 덮어씁니다.
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_PRESIGNED_ENDPOINT=http://localhost:9000
# STORAGE_REGION=us-east-1
# STORAGE_BUCKET=self-intro-images
# STORAGE_ACCESS_KEY=minioadmin
# STORAGE_SECRET_KEY=minioadmin
# STORAGE_PATH_STYLE_ACCESS=true
# STORAGE_PRESIGNED_TTL_SECONDS=300
# STORAGE_PUBLIC_BASE_URL=http://localhost:9000/self-intro-images

# 가입 초대와 Workspace 참여 초대 개인정보 보존 정책. 종결 또는 만료 후 30일이 지나면
# 매일 제한된 건수만 삭제합니다.
INVITATION_RETENTION_ENABLED=true
INVITATION_RETENTION_CLOSED_FOR=30d
INVITATION_RETENTION_BATCH_SIZE=500
INVITATION_RETENTION_CLEANUP_CRON=0 30 3 * * *
INVITATION_RETENTION_TIME_ZONE=Asia/Seoul
# 비밀번호 재설정 메일. 로컬 Compose는 Mailpit과 아래 값을 자동 연결합니다.
# 운영에서는 SMTP 자격증명과 함께 메일 발송을 명시적으로 활성화해야 합니다.
ACCOUNT_RECOVERY_EMAIL_ENABLED=true
ACCOUNT_RECOVERY_EMAIL_FROM=no-reply@self-intro.local
PASSWORD_RESET_BASE_URL=http://localhost:3000/password-reset
EMAIL_CHANGE_BASE_URL=http://localhost:3000/account/email-change
PASSWORD_RESET_TOKEN_VALID_FOR=30m
AUTH_PASSWORD_RESET_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_PASSWORD_RESET_RATE_LIMIT_WINDOW=10m
WORKSPACE_DELETION_GRACE_PERIOD=30d
# Worker scheduler and every provider delete switch must all be enabled before a purge can run.
WORKSPACE_PURGE_EXECUTION_ENABLED=false
WORKSPACE_PURGE_EXECUTION_CRON=0 */10 * * * *
WORKSPACE_PURGE_TIME_ZONE=Asia/Seoul
WORKSPACE_PURGE_LEASE_TIMEOUT=2h
WORKSPACE_PURGE_BATCH_SIZE=10
WORKSPACE_PURGE_OBJECT_STORAGE_DELETE_ENABLED=false
WORKSPACE_PURGE_MYSQL_DELETE_ENABLED=false
WORKSPACE_PURGE_VECTOR_DELETE_ENABLED=false
WORKSPACE_PURGE_CACHE_DELETE_ENABLED=false
MAINTENANCE_MODE=false
WORKSPACE_RESTORE_RECONCILIATION_ENABLED=false
# Workspace 데이터가 아니라 공통 채용공고 catalog만 저장한다. 기존 JobPostingReadModel은
# matchScore/matchSummary 레거시 검사용으로만 남기며 새 쓰기 대상에 사용하지 않는다.
ORACLE_NOSQL_TABLE=JobPostingCatalogReadModel
