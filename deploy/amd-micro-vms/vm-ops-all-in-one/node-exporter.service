[Unit]
Description=Prometheus Node Exporter
Wants=network-online.target
After=network-online.target

[Service]
User=node_exporter
Group=node_exporter
Type=simple
ExecStart=/usr/local/bin/node_exporter

Restart=always
RestartSec=3s

# Resource Control
MemoryMax=50M
CPUWeight=20

[Install]
WantedBy=multi-user.target
