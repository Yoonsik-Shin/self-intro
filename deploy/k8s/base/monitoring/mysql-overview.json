{
  "title": "[DB] MySQL Primary Database Health",
  "uid": "mysql-overview",
  "tags": ["mysql"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Up",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }] }, "overrides": [] },
      "targets": [{ "expr": "mysql_up", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [{ "expr": "mysql_global_status_uptime", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Threads Connected",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "mysql_global_status_threads_connected", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Max Connections",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "mysql_global_variables_max_connections", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Slow Queries",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "mysql_global_status_slow_queries", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "InnoDB Buffer Pool (data)",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [{ "expr": "mysql_global_status_innodb_buffer_pool_bytes_data", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Queries / sec",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "rate(mysql_global_status_queries[1m])", "legendFormat": "queries/s", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Commands by Type (rate)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "rate(mysql_global_status_commands_total{command=\"select\"}[1m])", "legendFormat": "select", "refId": "A" },
        { "expr": "rate(mysql_global_status_commands_total{command=\"insert\"}[1m])", "legendFormat": "insert", "refId": "B" },
        { "expr": "rate(mysql_global_status_commands_total{command=\"update\"}[1m])", "legendFormat": "update", "refId": "C" },
        { "expr": "rate(mysql_global_status_commands_total{command=\"delete\"}[1m])", "legendFormat": "delete", "refId": "D" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Network Bytes",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        { "expr": "rate(mysql_global_status_bytes_received[1m])", "legendFormat": "received", "refId": "A" },
        { "expr": "rate(mysql_global_status_bytes_sent[1m])", "legendFormat": "sent", "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Threads Connected",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "mysql_global_status_threads_connected", "legendFormat": "connected", "refId": "A" }]
    }
  ]
}
