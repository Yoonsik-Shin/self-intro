{
  "title": "Oracle ATP Overview",
  "uid": "oracle-atp-overview",
  "tags": ["oracle", "atp"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Up",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }] }, "overrides": [] },
      "targets": [{ "expr": "oracledb_up", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Active Sessions",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "oracledb_sessions_value{status=\"ACTIVE\"}", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Process Count",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "oracledb_process_count", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Exporter Scrape Errors",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "oracledb_exporter_last_scrape_error", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Sessions (active / inactive)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "oracledb_sessions_value{status=\"ACTIVE\"}", "legendFormat": "active", "refId": "A" },
        { "expr": "oracledb_sessions_value{status=\"INACTIVE\"}", "legendFormat": "inactive", "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tablespace Used %",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 }, "overrides": [] },
      "targets": [{ "expr": "oracledb_tablespace_used_percent", "legendFormat": "{{tablespace}}", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Activity (execute / parse / commit / rollback)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "rate(oracledb_activity_execute_count[5m])", "legendFormat": "execute", "refId": "A" },
        { "expr": "rate(oracledb_activity_parse_count_total[5m])", "legendFormat": "parse", "refId": "B" },
        { "expr": "rate(oracledb_activity_user_commits[5m])", "legendFormat": "commit", "refId": "C" },
        { "expr": "rate(oracledb_activity_user_rollbacks[5m])", "legendFormat": "rollback", "refId": "D" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Wait Time by Class",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "oracledb_wait_time_user_io", "legendFormat": "user_io", "refId": "A" },
        { "expr": "oracledb_wait_time_system_io", "legendFormat": "system_io", "refId": "B" },
        { "expr": "oracledb_wait_time_concurrency", "legendFormat": "concurrency", "refId": "C" },
        { "expr": "oracledb_wait_time_application", "legendFormat": "application", "refId": "D" },
        { "expr": "oracledb_wait_time_network", "legendFormat": "network", "refId": "E" },
        { "expr": "oracledb_wait_time_other", "legendFormat": "other", "refId": "F" }
      ]
    },
    {
      "type": "timeseries",
      "title": "ASM Diskgroup Free Bytes",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [{ "expr": "oracledb_asm_diskgroup_free", "legendFormat": "{{name}}", "refId": "A" }]
    }
  ]
}
