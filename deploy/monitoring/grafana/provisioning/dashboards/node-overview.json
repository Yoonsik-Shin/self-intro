{
  "title": "[Infra] Kubernetes Node Resources",
  "uid": "node-overview",
  "tags": ["node", "infra"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Node Ready",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "NOT READY" }, "1": { "text": "READY" } } }] }, "overrides": [] },
      "targets": [{ "expr": "kube_node_status_condition{condition=\"Ready\",status=\"true\"} * on(node) group_left(label_self_intro_io_node_role) kube_node_labels{label_self_intro_io_node_role!=\"\"}", "legendFormat": "{{label_self_intro_io_node_role}} · {{node}}", "refId": "A" }]
    },
    {
      "type": "gauge",
      "title": "CPU Usage",
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 0 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] },
      "targets": [{ "expr": "(100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)) * on(instance) group_left(label_self_intro_io_node_role) label_replace(kube_node_labels{label_self_intro_io_node_role!=\"\"}, \"instance\", \"$1\", \"node\", \"(.*)\")", "legendFormat": "{{label_self_intro_io_node_role}} · {{instance}}", "refId": "A" }]
    },
    {
      "type": "gauge",
      "title": "Memory Usage",
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 0 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] },
      "targets": [{ "expr": "((1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100) * on(instance) group_left(label_self_intro_io_node_role) label_replace(kube_node_labels{label_self_intro_io_node_role!=\"\"}, \"instance\", \"$1\", \"node\", \"(.*)\")", "legendFormat": "{{label_self_intro_io_node_role}} · {{instance}}", "refId": "A" }]
    },
    {
      "type": "gauge",
      "title": "Disk Usage (/)",
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] },
      "targets": [{ "expr": "((1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100) * on(instance) group_left(label_self_intro_io_node_role) label_replace(kube_node_labels{label_self_intro_io_node_role!=\"\"}, \"instance\", \"$1\", \"node\", \"(.*)\")", "legendFormat": "{{label_self_intro_io_node_role}} · {{instance}}", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Load Average (1m)",
      "gridPos": { "h": 4, "w": 6, "x": 19, "y": 0 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "node_load1 * on(instance) group_left(label_self_intro_io_node_role) label_replace(kube_node_labels{label_self_intro_io_node_role!=\"\"}, \"instance\", \"$1\", \"node\", \"(.*)\")", "legendFormat": "{{label_self_intro_io_node_role}} · {{instance}}", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "CPU Usage %",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 }, "overrides": [] },
      "targets": [{ "expr": "(100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)) * on(instance) group_left(label_self_intro_io_node_role) label_replace(kube_node_labels{label_self_intro_io_node_role!=\"\"}, \"instance\", \"$1\", \"node\", \"(.*)\")", "legendFormat": "{{label_self_intro_io_node_role}} · {{instance}}", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Memory Used / Total",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        { "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) * on(instance) group_left(label_self_intro_io_node_role) label_replace(kube_node_labels{label_self_intro_io_node_role!=\"\"}, \"instance\", \"$1\", \"node\", \"(.*)\")", "legendFormat": "{{label_self_intro_io_node_role}} · {{instance}} · used", "refId": "A" },
        { "expr": "node_memory_MemTotal_bytes * on(instance) group_left(label_self_intro_io_node_role) label_replace(kube_node_labels{label_self_intro_io_node_role!=\"\"}, \"instance\", \"$1\", \"node\", \"(.*)\")", "legendFormat": "{{label_self_intro_io_node_role}} · {{instance}} · total", "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Load Average",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "node_load1 * on(instance) group_left(label_self_intro_io_node_role) label_replace(kube_node_labels{label_self_intro_io_node_role!=\"\"}, \"instance\", \"$1\", \"node\", \"(.*)\")", "legendFormat": "{{label_self_intro_io_node_role}} · {{instance}} · 1m", "refId": "A" },
        { "expr": "node_load5 * on(instance) group_left(label_self_intro_io_node_role) label_replace(kube_node_labels{label_self_intro_io_node_role!=\"\"}, \"instance\", \"$1\", \"node\", \"(.*)\")", "legendFormat": "{{label_self_intro_io_node_role}} · {{instance}} · 5m", "refId": "B" },
        { "expr": "node_load15 * on(instance) group_left(label_self_intro_io_node_role) label_replace(kube_node_labels{label_self_intro_io_node_role!=\"\"}, \"instance\", \"$1\", \"node\", \"(.*)\")", "legendFormat": "{{label_self_intro_io_node_role}} · {{instance}} · 15m", "refId": "C" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Network I/O",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        { "expr": "rate(node_network_receive_bytes_total{device!=\"lo\"}[5m]) * on(instance) group_left(label_self_intro_io_node_role) label_replace(kube_node_labels{label_self_intro_io_node_role!=\"\"}, \"instance\", \"$1\", \"node\", \"(.*)\")", "legendFormat": "{{label_self_intro_io_node_role}} · {{instance}} · rx {{device}}", "refId": "A" },
        { "expr": "rate(node_network_transmit_bytes_total{device!=\"lo\"}[5m]) * on(instance) group_left(label_self_intro_io_node_role) label_replace(kube_node_labels{label_self_intro_io_node_role!=\"\"}, \"instance\", \"$1\", \"node\", \"(.*)\")", "legendFormat": "{{label_self_intro_io_node_role}} · {{instance}} · tx {{device}}", "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Disk Usage % by Mount",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 }, "overrides": [] },
      "targets": [{ "expr": "((1 - node_filesystem_avail_bytes{fstype!=\"tmpfs\"} / node_filesystem_size_bytes{fstype!=\"tmpfs\"}) * 100) * on(instance) group_left(label_self_intro_io_node_role) label_replace(kube_node_labels{label_self_intro_io_node_role!=\"\"}, \"instance\", \"$1\", \"node\", \"(.*)\")", "legendFormat": "{{label_self_intro_io_node_role}} · {{instance}} · {{mountpoint}}", "refId": "A" }]
    }
  ]
}
