{
  "title": "[Cache] Redis Memory & Session Health",
  "uid": "redis-overview",
  "tags": ["redis", "cache"],
  "timezone": "browser",
  "schemaVersion": 30,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Memory Used",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "legendFormat": "Used Memory"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 2,
      "title": "Connected Clients",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "redis_connected_clients",
          "legendFormat": "Clients"
        }
      ]
    },
    {
      "id": 3,
      "title": "Commands Processed / sec",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(redis_commands_processed_total[1m])",
          "legendFormat": "Ops/sec"
        }
      ]
    },
    {
      "id": 4,
      "title": "Evicted Keys",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "redis_evicted_keys_total",
          "legendFormat": "Evicted"
        }
      ]
    },
    {
      "id": 5,
      "title": "Memory Consumption Trend",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "legendFormat": "Used Bytes"
        },
        {
          "expr": "redis_memory_max_bytes",
          "legendFormat": "Max Bytes"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 6,
      "title": "Command Execution Rate (by Command)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum(rate(redis_command_call_duration_seconds_count[1m])) by (cmd)",
          "legendFormat": "{{cmd}}"
        }
      ]
    }
  ]
}
