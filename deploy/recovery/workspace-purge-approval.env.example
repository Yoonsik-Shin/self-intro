# 이 파일은 형식 예시이며 실제 승인 증적이 아니다.
# 실제 운영 flag를 열기 전 같은 디렉터리에 workspace-purge-approval.env를 만들고,
# 비밀번호·access key·개인정보가 아닌 승인 메타데이터만 기록한다.

APPROVAL_REF=internal-change-record-without-personal-data
APPROVED_BY_ROLE=platform-owner
EVIDENCE_EXPIRES_AT=2099-12-31

# 보존본이 삭제 유예보다 오래 남지 않게 둘 다 WORKSPACE_DELETION_GRACE_PERIOD 이하여야 한다.
MYSQL_BACKUP_RETENTION_DAYS=14
MYSQL_BACKUP_RPO_HOURS=24
MYSQL_BACKUP_ENCRYPTION_VERIFIED=true
MYSQL_RESTORE_REHEARSAL_AT=2099-12-01
MYSQL_RESTORE_REHEARSAL_VERIFIED=true

OBJECT_STORAGE_PROVIDER=oci-object-storage
OBJECT_BACKUP_RETENTION_DAYS=14
OBJECT_PUBLIC_BUCKET_VERSIONING_VERIFIED=true
OBJECT_PRIVATE_BUCKET_VERSIONING_VERIFIED=true
OBJECT_RESTORE_REHEARSAL_AT=2099-12-01
OBJECT_RESTORE_REHEARSAL_VERIFIED=true

# 오래된 backup 복원 직후 외부 트래픽을 열지 않고 DELETED/PENDING purge를 먼저 재조정한다.
RESTORE_MAINTENANCE_MODE_VERIFIED=true
POST_RESTORE_PURGE_RECONCILIATION_VERIFIED=true
