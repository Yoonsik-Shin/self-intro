# syntax=docker/dockerfile:1
# Worker Microservice Dockerfile

# Stage 1: Build stage
FROM --platform=$BUILDPLATFORM eclipse-temurin:21-jdk-jammy AS builder

WORKDIR /app

# Gradle wrapper 및 설정 파일 복사
COPY gradlew .
COPY gradle gradle
COPY build.gradle settings.gradle ./
COPY api/build.gradle api/
COPY ai-worker/build.gradle ai-worker/
COPY secret-bootstrap/build.gradle secret-bootstrap/

RUN chmod +x gradlew

# Playwright 클래스패스 추출
RUN --mount=type=cache,target=/root/.gradle,sharing=locked ./gradlew :ai-worker:copyPlaywrightClasspath --no-daemon

# 소스코드 복사 및 Jar 빌드 (ai-worker 전용)
COPY api api
COPY ai-worker ai-worker
RUN --mount=type=cache,target=/root/.gradle,sharing=locked ./gradlew :ai-worker:bootJar --no-daemon -x test

# Stage 2: Runtime stage
FROM eclipse-temurin:21-jre-jammy

WORKDIR /app

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

ARG APP_UID=10001
ARG APP_GID=10001

RUN --mount=type=bind,from=builder,source=/app/ai-worker/build/playwright-classpath,target=/tmp/playwright-classpath \
    apt-get update \
    && java -cp "/tmp/playwright-classpath/*" com.microsoft.playwright.CLI install --with-deps \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid "${APP_GID}" spring \
    && useradd --uid "${APP_UID}" --gid spring --no-create-home --shell /usr/sbin/nologin spring \
    && mkdir -p /app/logs \
    && chown -R spring:spring /app /ms-playwright

COPY --from=builder /app/ai-worker/build/libs/ai-worker-0.1.0.jar app.jar


USER 10001:10001

EXPOSE 9090 8081

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
