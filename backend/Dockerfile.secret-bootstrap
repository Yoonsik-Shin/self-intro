# syntax=docker/dockerfile:1
FROM --platform=$BUILDPLATFORM eclipse-temurin:21-jdk-jammy AS builder

WORKDIR /app
COPY gradlew .
COPY gradle gradle
COPY build.gradle settings.gradle ./
COPY api/build.gradle api/
COPY ai-worker/build.gradle ai-worker/
COPY secret-bootstrap/build.gradle secret-bootstrap/
RUN chmod +x gradlew
COPY secret-bootstrap secret-bootstrap
RUN --mount=type=cache,target=/root/.gradle,sharing=locked \
    ./gradlew :secret-bootstrap:bootJar --no-daemon -x test

FROM eclipse-temurin:21-jre-jammy

ARG APP_UID=10001
ARG APP_GID=10001
RUN groupadd --gid "${APP_GID}" bootstrap \
    && useradd --uid "${APP_UID}" --gid bootstrap --no-create-home --shell /usr/sbin/nologin bootstrap
COPY --from=builder /app/secret-bootstrap/build/libs/secret-bootstrap.jar /app/secret-bootstrap.jar
USER 10001:10001
ENTRYPOINT ["java", "-jar", "/app/secret-bootstrap.jar"]
